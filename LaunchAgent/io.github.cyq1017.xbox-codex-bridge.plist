<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.cyq1017.xbox-codex-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/Applications/XboxCodexBridge.app/Contents/MacOS/XboxCodexBridge</string>
    <string>--no-open</string>
    <string>--no-permission-prompt</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@HOME@/Library/Application Support/XboxCodexBridge</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/XboxCodexBridge.log</string>

  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/XboxCodexBridge.error.log</string>
</dict>
</plist>
